{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tune",
  "version": "0.0.0",
  "identifier": "ai.tune.studio",
  "build": {
    "beforeDevCommand": "pnpm --filter @tune/desktop dev",
    "beforeBuildCommand": "pnpm --filter @tune/desktop build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tune",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
