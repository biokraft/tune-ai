.env
*.local.toml

# OS / editor
.DS_Store
.idea/
.vscode/
/scratch/

# Per-song edit log (who changed what, when): local, never committed
songs/*/edits.jsonl

# Tauri generated schemas
apps/desktop/src-tauri/gen/
